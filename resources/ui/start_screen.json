{
  "namespace": "start",
  "playback_replay_button@start.main_button": {
    "$button_text": "playback.ui.replays",
    "$pressed_button_name": "button.playback_open_replays",
    "$focus_id": "playback_replays_button",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      }
    ]
  },
  "main_buttons_panel/stacked_rows": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_after",
        "control_name": "play",
        "value": {
          "playback_replay_row@start.stacked_row": {
            "controls": [
              {
                "playback_replay_button@start.playback_replay_button": {}
              }
            ]
          }
        }
      }
    ]
  },
  "start_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "playback_replay_popup_factory": {
            "type": "factory",
            "control_ids": {
              "playback_replay_browser": "@playback.replay_dialog"
            }
          }
        }
      }
    ]
  }
}
